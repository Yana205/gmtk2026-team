# =============================================================================
# .gitignore for a Unity project (Unity 6)
# Cross-platform: works for macOS + Windows + Linux teammates.
# Based on github/gitignore Unity.gitignore + macOS + Windows + JetBrains/VS.
# =============================================================================

# -----------------------------------------------------------------------------
# Unity generated / local caches — NEVER commit these
# -----------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size and may contain sensitive data.
/[Mm]emoryCaptures/

# Recordings can get excessive in size.
/[Rr]ecordings/

# Asset meta files must be kept in sync — never ignore them.
# (Nothing below should match *.meta; this is a safety net.)
!*.meta

# Uncomment if you use the Asset Store Tools plugin.
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# -----------------------------------------------------------------------------
# IDE / editor project files (regenerated by Unity per-machine)
# -----------------------------------------------------------------------------
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# -----------------------------------------------------------------------------
# Build outputs / packaged artifacts
# -----------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# -----------------------------------------------------------------------------
# macOS
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# -----------------------------------------------------------------------------
# Windows
# -----------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# -----------------------------------------------------------------------------
# Claude Code — keep shared skills tracked, ignore per-user local overrides
# -----------------------------------------------------------------------------
.claude/settings.local.json
.claude/**/settings.local.json
