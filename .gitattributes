# =============================================================================
# .gitattributes for a cross-platform Unity team (macOS + Windows + Linux)
#
# Purpose:
#   1. Normalize line endings so Mac/Windows teammates stop fighting CRLF/LF.
#   2. Mark binary assets so Git never tries to text-merge or diff them.
#
# NOTE ON GIT LFS:
#   Git LFS is NOT enabled here on purpose — `git lfs` is not installed on this
#   machine, and enabling LFS filters would break commits for teammates who
#   don't have LFS installed. If your art/audio grows large (big .psd, .wav,
#   video, etc.), install Git LFS on EVERY machine first, then uncomment the
#   "GIT LFS" block at the bottom and run `git lfs install`.
# =============================================================================

# Auto-normalize text files; Git decides what is text.
* text=auto

# ----- Force LF for source & Unity text assets (stable cross-platform diffs) -
*.cs        text eol=lf diff=csharp
*.js        text eol=lf
*.ts        text eol=lf
*.shader    text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.compute   text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.uxml      text eol=lf
*.uss       text eol=lf

# Unity YAML-based assets — text, and useful with UnityYAMLMerge (Smart Merge).
*.meta            text eol=lf merge=unityyamlmerge
*.unity           text eol=lf merge=unityyamlmerge
*.asset           text eol=lf merge=unityyamlmerge
*.prefab          text eol=lf merge=unityyamlmerge
*.mat             text eol=lf merge=unityyamlmerge
*.anim            text eol=lf merge=unityyamlmerge
*.controller      text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.physicMaterial  text eol=lf merge=unityyamlmerge
*.physicsMaterial2D text eol=lf merge=unityyamlmerge
*.playable        text eol=lf merge=unityyamlmerge
*.mask            text eol=lf merge=unityyamlmerge
*.brush           text eol=lf merge=unityyamlmerge
*.flare           text eol=lf merge=unityyamlmerge
*.fontsettings    text eol=lf merge=unityyamlmerge
*.guiskin         text eol=lf merge=unityyamlmerge
*.giparams        text eol=lf merge=unityyamlmerge
*.renderTexture   text eol=lf merge=unityyamlmerge
*.spriteatlas     text eol=lf merge=unityyamlmerge
*.terrainlayer    text eol=lf merge=unityyamlmerge
*.mixer           text eol=lf merge=unityyamlmerge
*.shadervariants  text eol=lf merge=unityyamlmerge
*.preset          text eol=lf merge=unityyamlmerge
*.asmdef          text eol=lf
*.asmref          text eol=lf
*.inputactions    text eol=lf
*.scenetemplate   text eol=lf

# ----- Binary assets: never text-merge, never diff -----
# Images
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.tga   binary
*.tif   binary
*.tiff  binary
*.psd   binary
*.ai    binary
*.exr   binary
*.hdr   binary
*.ico   binary
*.svg   binary
# 3D models
*.fbx   binary
*.obj   binary
*.blend binary
*.dae   binary
*.3ds   binary
*.ma    binary
*.mb    binary
# Audio
*.wav   binary
*.mp3   binary
*.ogg   binary
*.aif   binary
*.aiff  binary
*.flac  binary
# Video
*.mp4   binary
*.mov   binary
*.webm  binary
# Fonts
*.ttf   binary
*.otf   binary
# Native libs / packages
*.dll   binary
*.so    binary
*.dylib binary
*.a     binary
*.lib   binary
*.pdb   binary
*.bytes binary
*.unitypackage binary
*.aar   binary

# =============================================================================
# GIT LFS (disabled — see NOTE above). To enable:
#   1) Install Git LFS on every machine:  https://git-lfs.com
#   2) Run once per clone:  git lfs install
#   3) Uncomment the lines you want, then re-add the files.
# -----------------------------------------------------------------------------
# *.psd  filter=lfs diff=lfs merge=lfs -text
# *.wav  filter=lfs diff=lfs merge=lfs -text
# *.mp4  filter=lfs diff=lfs merge=lfs -text
# *.fbx  filter=lfs diff=lfs merge=lfs -text
# =============================================================================
